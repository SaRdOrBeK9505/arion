# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — frontend domeni(lari), vergul bilan ajratilgan
CORS_ALLOWED_ORIGINS=https://arion-export.uz

# Nginx orqasida bo'lsa, uning REMOTE_ADDR IP'i (odatda 127.0.0.1)
TRUSTED_PROXY_IPS=127.0.0.1

# Database
DB_NAME=arion_export
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# MONTRA Payment Gateway - TEST
MONTRA_API_KEY_TEST=your-test-api-key
MONTRA_SECRET_KEY_TEST=your-test-secret-key
MONTRA_BASE_URL_TEST=https://api.montratech.com/api/v1
# Dashboard → Settings → Webhooks'dagi ALOHIDA Webhook Secret
# (MONTRA_SECRET_KEY_TEST bilan bir xil EMAS!)
MONTRA_WEBHOOK_SECRET_TEST=your-test-webhook-secret

# MONTRA Payment Gateway - LIVE
MONTRA_API_KEY_LIVE=your-live-api-key
MONTRA_SECRET_KEY_LIVE=your-live-secret-key
MONTRA_BASE_URL_LIVE=https://api.montratech.com/api/v1
MONTRA_WEBHOOK_SECRET_LIVE=your-live-webhook-secret

# Use TEST or LIVE
MONTRA_MODE=TEST

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-admin-chat-id

# Sentry
SENTRY_DSN=your-sentry-dsn

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
